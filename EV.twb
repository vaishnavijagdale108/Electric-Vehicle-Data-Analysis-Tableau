      <aliases enabled='yes' />
      <column caption='Total Vehicles' datatype='integer' name='[Calculation_1475016826626048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([DOL Vehicle ID])' />
      </column>
      <column caption='Average Electric Range' datatype='real' name='[Calculation_1475016828039169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='Total BEV Vehicles ' datatype='integer' name='[Calculation_1475016834543618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot;&#13;&#10;THEN [DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% of Total BEV Vehicles' datatype='real' name='[Calculation_1475016836382723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1475016834543618] / [Calculation_1475016826626048]' />
      </column>
      <column caption='Total PHEV Vehicles ' datatype='integer' name='[Calculation_1475016840495108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] =&quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#13;&#10;THEN&#13;&#10;[DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% of Total PHEV Vehicles' datatype='real' name='[Calculation_1475016841142278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1475016840495108]/[Calculation_1475016826626048]' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='CAFV Eligibility' datatype='string' name='[Clean Alternative Fuel Vehicle (CAFV) Eligibility]' role='dimension' type='nominal'>
